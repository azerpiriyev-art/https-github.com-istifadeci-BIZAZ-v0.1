# Copy to .env.production on the server. Never commit the real .env.production file.
# Generate URL-safe secrets with: openssl rand -hex 32 (passwords) and openssl rand -hex 64 (JWT_SECRET).
POSTGRES_DB=bizaz
POSTGRES_USER=bizaz_admin
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_ADMIN_PASSWORD
BIZAZ_APP_USER=bizaz_app
BIZAZ_APP_PASSWORD=REPLACE_WITH_64_HEX_CHAR_APP_PASSWORD
JWT_SECRET=REPLACE_WITH_128_HEX_CHAR_JWT_SECRET
JWT_EXPIRE_MINUTES=30
BIZAZ_DOMAIN=bizaz.example.com
CORS_ORIGINS=https://bizaz.example.com
# Empty means browser requests use the same HTTPS origin; Caddy forwards /api/* to FastAPI.
NEXT_PUBLIC_API_URL=
