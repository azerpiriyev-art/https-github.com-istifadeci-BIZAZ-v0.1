# Copy this file to .env.production in the repository root.
# Replace every placeholder before using production Compose.
BIZAZ_DOMAIN=your-real-domain.example
BIZAZ_PUBLIC_ORIGIN=https://your-real-domain.example
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
BIZAZ_DB_APP_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
BIZAZ_DB_MIGRATOR_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
JWT_SECRET=REPLACE_WITH_128_HEX_CHARACTERS
JWT_EXPIRE_MINUTES=30
